}, {
  "@id" : "http://purl.org/linked-data/sdmx/2009/dimension#sex",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/linked-data/cube#concept" : [ {
    "@id" : "http://purl.org/linked-data/sdmx/2009/concept#sex"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://purl.org/linked-data/cube#DimensionProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "El sexo se refiere al sexo biológico de la persona. Según la OMS, el sexo hace referencia a las características biológicas y fisiológicas que definen a hombres y mujeres, mientras que el género se refiere a los roles, conductas, actividades y atributos construidos socialmente que una cultura determinada considera apropiados para hombres y mujeres. De acuerdo con esta descripción, la OMS considera que hombre y mujer son categorías de sexo, mientras que masculino y femenino son categorías de género."
  }, {
    "@language" : "en",
    "@value" : "The state of being male or female."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://sdmx.org/wp-content/uploads/01_sdmx_cog_annex_1_cdc_2009.pdf"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Reference person gender"
  }, {
    "@language" : "en",
    "@value" : "Sex"
  }, {
    "@language" : "es",
    "@value" : "Sexo"
  }, {
    "@language" : "es",
    "@value" : "Sexo de la persona de referencia"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2000/01/rdf-schema#Resource"
  } ]
