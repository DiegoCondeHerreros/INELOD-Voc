@base <http://lod.ine.es/def/vocabulary/> .

<http://lod.ine.es/def/vocabulary/> rdf:type owl:Ontology ;
                                     owl:versionIRI <http://lod.ine.es/def/vocabulary/1.0.0> ;
                                     <http://creativecommons.org/ns#license> <https://creativecommons.org/licenses/by/4.0/legalcode> ;
                                     <http://purl.org/dc/terms/contributor> "Diego Conde-Herreros" ,
                                                                            "Luis M. Vilches-Blázquez" ,
                                                                            "Oscar Corcho" ;
                                     <http://purl.org/dc/terms/created> "2025-05-01"^^xsd:date ;
                                     <http://purl.org/dc/terms/creator> "Diego Conde-Herreros" ;
                                     <http://purl.org/dc/terms/description> "An ontology for describing the variables used as dimensions and measures in the RDF data cubes from the Instituto Nacional de Estadística"@en ,
                                                                            "Una ontologia para describir las variables empleadas como dimensiones y medidas en los cubos de datos en RDF del Instituto Nacional de Estadística"@es ;
                                     <http://purl.org/dc/terms/modified> "2025-09-23"^^xsd:date ;
                                     <http://purl.org/dc/terms/title> "INELOD VOC" ;
                                     <http://purl.org/vocab/vann/preferredNamespacePrefix> "ine" ;
                                     <http://purl.org/vocab/vann/preferredNamespaceUri> <http://lod.ine.es/def/vocabulary/> ;
                                     owl:versionInfo "1.0.0"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://creativecommons.org/ns#license
<http://creativecommons.org/ns#license> rdf:type owl:AnnotationProperty .


###  http://lod.ine.es/def/vocabulary/bedplacesPerTouristDwelling
:bedplacesPerTouristDwelling rdf:type owl:AnnotationProperty ;
                             rdfs:subPropertyOf :rate .


###  http://lod.ine.es/def/vocabulary/contractingPartiesGender
:contractingPartiesGender rdf:type owl:AnnotationProperty ;
