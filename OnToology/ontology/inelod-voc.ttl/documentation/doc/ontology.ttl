#################################################################
#    Classes
#################################################################

###  http://lod.ine.es/def/vocabulary/CensusSection
:CensusSection rdf:type owl:Class ;
               rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
               rdfs:comment "Unidad territorial de menor nivel definida por el INE para la organización del Censo Electoral. Identificada por un código de 10 dígitos: 2 de provincia + 3 de municipio + 2 de distrito + 3 de sección."@es ;
               rdfs:label "Census section"@en ,
                          "Sección censal"@es .


###  http://lod.ine.es/def/vocabulary/District
:District rdf:type owl:Class ;
          rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
          rdfs:comment "Subdivisión administrativa de un municipio. En municipios grandes (Madrid, Barcelona, Valencia, etc.) los distritos agrupan secciones censales y son la unidad territorial intermedia entre el municipio y la sección censal."@es ;
          rdfs:label "District"@en ,
                     "Distrito"@es .


###  http://lod.ine.es/def/vocabulary/MeasureSet
:MeasureSet rdf:type owl:Class ;
            rdfs:comment "La clase OWL que representa a aquellas variables del INE que corresponden al conjunto de medidas de un conjunto de datos"@es ;
            rdfs:label "Conjunto de Medidas"@es ,
                       "Set of Measurements"@en .


###  http://lod.ine.es/def/vocabulary/Municipality
:Municipality rdf:type owl:Class ;
              rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> .


###  http://lod.ine.es/def/vocabulary/ReasonType
:ReasonType rdf:type owl:Class ;
            rdfs:comment "La causa o la razón que mueve algo"@es ,
                         "The cause or reason that moves something"@en ;
            rdfs:label "Reason type"@en ,
                       "Tipo de razón"@es .


###  http://purl.org/linked-data/cube#DimensionProperty
<http://purl.org/linked-data/cube#DimensionProperty> rdf:type owl:Class .


###  http://purl.org/linked-data/cube#MeasureProperty
<http://purl.org/linked-data/cube#MeasureProperty> rdf:type owl:Class .


###  http://purl.org/linked-data/cube#Observation
<http://purl.org/linked-data/cube#Observation> rdf:type owl:Class .


###  http://purl.org/linked-data/sdmx#CodeList
<http://purl.org/linked-data/sdmx#CodeList> rdf:type owl:Class .


###  http://purl.org/linked-data/sdmx/2009/code#currency
<http://purl.org/linked-data/sdmx/2009/code#currency> rdf:type owl:Class .


###  http://qudt.org/vocab/unit#PERCENT
<http://qudt.org/vocab/unit#PERCENT> rdf:type owl:Class .


###  http://www.w3.org/2000/01/rdf-schema#Resource
rdfs:Resource rdf:type owl:Class .


###  http://www.w3.org/2004/02/skos/core#Concept
<http://www.w3.org/2004/02/skos/core#Concept> rdf:type owl:Class .


###  http://www.w3.org/2004/02/skos/core#ConceptScheme
<http://www.w3.org/2004/02/skos/core#ConceptScheme> rdf:type owl:Class .


