        <terms:creator>Diego Conde-Herreros</terms:creator>
        <terms:description xml:lang="en">An ontology for describing the variables used as dimensions and measures in the RDF data cubes from the Instituto Nacional de Estadística</terms:description>
        <terms:description xml:lang="es">Una ontologia para describir las variables empleadas como dimensiones y medidas en los cubos de datos en RDF del Instituto Nacional de Estadística</terms:description>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-09-23</terms:modified>
        <terms:title>INELOD VOC</terms:title>
        <vann:preferredNamespacePrefix>ine</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri rdf:resource="http://lod.ine.es/def/vocabulary/"/>
        <owl:versionInfo xml:lang="en">1.0.0</owl:versionInfo>
    </owl:Ontology>
    


