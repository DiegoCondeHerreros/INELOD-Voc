    <!-- http://lod.ine.es/def/vocabulary/CensusSection -->


    <owl:Class rdf:about="http://lod.ine.es/def/vocabulary/CensusSection">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="es">Unidad territorial de menor nivel definida por el INE para la organización del Censo Electoral. Identificada por un código de 10 dígitos: 2 de provincia + 3 de municipio + 2 de distrito + 3 de sección.</rdfs:comment>
        <rdfs:label xml:lang="en">Census section</rdfs:label>
        <rdfs:label xml:lang="es">Sección censal</rdfs:label>
    </owl:Class>
    


    <!-- http://lod.ine.es/def/vocabulary/District -->


    <owl:Class rdf:about="http://lod.ine.es/def/vocabulary/District">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="es">Subdivisión administrativa de un municipio. En municipios grandes (Madrid, Barcelona, Valencia, etc.) los distritos agrupan secciones censales y son la unidad territorial intermedia entre el municipio y la sección censal.</rdfs:comment>
        <rdfs:label xml:lang="en">District</rdfs:label>
        <rdfs:label xml:lang="es">Distrito</rdfs:label>
    </owl:Class>
    


    <!-- http://lod.ine.es/def/vocabulary/MeasureSet -->


    <owl:Class rdf:about="http://lod.ine.es/def/vocabulary/MeasureSet">
        <rdfs:comment xml:lang="es">La clase OWL que representa a aquellas variables del INE que corresponden al conjunto de medidas de un conjunto de datos</rdfs:comment>
        <rdfs:label xml:lang="es">Conjunto de Medidas</rdfs:label>
        <rdfs:label xml:lang="en">Set of Measurements</rdfs:label>
    </owl:Class>
    


    <!-- http://lod.ine.es/def/vocabulary/Municipality -->


    <owl:Class rdf:about="http://lod.ine.es/def/vocabulary/Municipality">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    </owl:Class>
    


    <!-- http://lod.ine.es/def/vocabulary/ReasonType -->


    <owl:Class rdf:about="http://lod.ine.es/def/vocabulary/ReasonType">
        <rdfs:comment xml:lang="es">La causa o la razón que mueve algo</rdfs:comment>
        <rdfs:comment xml:lang="en">The cause or reason that moves something</rdfs:comment>
        <rdfs:label xml:lang="en">Reason type</rdfs:label>
        <rdfs:label xml:lang="es">Tipo de razón</rdfs:label>
    </owl:Class>
    


